{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Color QC",
  "version": "0.3.5",
  "identifier": "com.studio.colorqc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Studio Color Consistency & Material QC System",
        "width": 1380,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
